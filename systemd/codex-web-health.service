[Unit]
Description=Functional health check for Codex Web
After=codex-app-server.service codex-web.service
OnFailure=codex-web-recover.service

[Service]
Type=oneshot
Environment=CODEX_APP_SERVER_BIN=%h/.local/share/mise/installs/codex/0.153.4/bin/codex
Environment=CODEX_MCP_NODE_PATH=%h/.local/share/mise/installs/node/22/bin/node
Environment=CODEX_DESKTOP_RESOURCES_PATH=%h/.local/share/codex-web-app/scratch/ChatGPT.app/Contents/Resources
Environment=CODEX_WEB_APP_TOOLS_PIPE_PATH=%t/codex-web/app-tools.sock
Environment=CODEX_UNIX_SOCKET=%t/codex-web/app-server.sock
Environment=CODEX_WEB_HEALTH_URL=http://127.0.0.1:8214/
Environment=CODEX_WEB_PROXY_PATH=%h/.local/bin/codex-web-app-server-proxy
Environment=CODEX_WEB_HEALTH_TIMEOUT_MS=15000
ExecStart=%h/.local/share/mise/installs/node/22/bin/node %h/.local/share/codex-web-app/scripts/codex_web_health.mjs
TimeoutStartSec=30
